{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "andersondapper.dev" }],
      "destination": "https://andersondapper.com.br/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "andersondapper.dev" }],
      "destination": "https://andersondapper.com.br/:path*",
      "permanent": true
    }
  ]
}
